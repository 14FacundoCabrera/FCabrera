---
import Monogram from './Monogram.astro';
import { content, contact, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const otherHref = lang === 'es' ? '/en/' : '/';
const otherLang = lang === 'es' ? 'en' : 'es';
const year = new Date().getFullYear();
const pad = (n: number) => String(n + 1).padStart(2, '0');
---
<a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>

<header class="site-header">
  <div class="wrap header-row">
    <a class="lockup" href={lang === 'es' ? '/' : '/en/'} aria-label={lang === 'es' ? 'FCabrera — inicio' : 'FCabrera — home'}>
      <Monogram id="header" width={44} accent="var(--accent-night)" ink="var(--paper)" label="" />
      <span class="wordmark" aria-hidden="true"><span>F</span>Cabrera</span>
    </a>
    <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <ul class="nav-links">
        <li class="hide-sm"><a href="#perfil">{t.nav.about}</a></li>
        <li class="hide-sm"><a href="#proyectos">{t.nav.projects}</a></li>
        <li class="hide-sm"><a href="#habilidades">{t.nav.skills}</a></li>
        <li class="hide-sm"><a href="#formacion">{t.nav.education}</a></li>
        <li><a href="#contacto">{t.nav.contact}</a></li>
        <li>
          <a class="lang-pill" href={otherHref} hreflang={otherLang} lang={otherLang}>
            <span aria-hidden="true">{t.nav.switchShort}</span>
            <span class="sr-only">{t.nav.switchLabel}</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<main id="main">
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title">Facundo Cabrera</h1>
        <p class="role">{t.hero.eyebrow}</p>
        <p class="lead">{t.hero.lead}</p>
        <p class="status"><span class="dot" aria-hidden="true"></span>{t.hero.status}</p>
        <div class="ctas">
          <a class="btn btn-primary" href="#proyectos">{t.hero.ctaPrimary}</a>
          <a class="btn btn-ghost" href="#contacto">{t.hero.ctaSecondary}</a>
        </div>
      </div>
      <div class="hero-mark" aria-hidden="true">
        <div class="tile">
          <Monogram id="hero" width={260} accent="var(--accent-night)" ink="var(--paper)" label="" />
        </div>
      </div>
    </div>
  </section>

  <!-- Profile -->
  <section id="perfil" class="section" aria-labelledby="perfil-title">
    <div class="wrap">
      <div class="split">
        <div>
          <p class="label">{t.about.label}</p>
          <h2 id="perfil-title">{t.about.title}</h2>
        </div>
        <div class="prose">
          {t.about.body.map((p) => <p>{p}</p>)}
          <h3 class="mini-title">{t.about.strengthsTitle}</h3>
          <ul class="checks">
            {t.about.strengths.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </div>

      <p class="label label-gap">{t.focus.label}</p>
      <ul class="focus-grid">
        {
          t.focus.items.map((f, i) => (
            <li class="card focus-card">
              <span class="num">{pad(i)}</span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Projects -->
  <section id="proyectos" class="section section-alt" aria-labelledby="proyectos-title">
    <div class="wrap">
      <p class="label">{t.projects.label}</p>
      <h2 id="proyectos-title">{t.projects.title}</h2>
      <div class="projects">
        {
          t.projects.items.map((p, i) => (
            <article class="card project">
              <header class="project-head">
                <span class="num">{pad(i)}</span>
                <h3>{p.name}</h3>
                <p class="project-role">{p.role}</p>
              </header>
              <div class="project-body">
                <p class="project-summary">{p.summary}</p>
                <ul class="checks">
                  {p.points.map((pt) => <li>{pt}</li>)}
                </ul>
                <ul class="chips" aria-label="Stack">
                  {p.stack.map((s) => <li>{s}</li>)}
                </ul>
                {p.repo && (
                  <a class="text-link" href={p.repo} rel="noopener" target="_blank">
                    {t.projects.repoLink}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg>
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section id="habilidades" class="section" aria-labelledby="habilidades-title">
    <div class="wrap">
      <p class="label">{t.skills.label}</p>
      <h2 id="habilidades-title">{t.skills.title}</h2>
      <div class="skills-grid">
        {
          t.skills.groups.map((g) => (
            <div class="skill-group">
              <h3>{g.title}</h3>
              <ul class="chips">
                {g.items.map((s) => <li>{s}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Education -->
  <section id="formacion" class="section section-alt" aria-labelledby="formacion-title">
    <div class="wrap">
      <p class="label">{t.education.label}</p>
      <div class="edu-grid">
        <div>
          <h2 id="formacion-title">{t.education.title}</h2>
          <ol class="timeline">
            {
              t.education.items.map((e) => (
                <li>
                  <span class="period">{e.period}</span>
                  <div>
                    <h3>{e.title}</h3>
                    {e.note && <p>{e.note}</p>}
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <aside class="card langs" aria-labelledby="langs-title">
          <h3 id="langs-title" class="mini-title">{t.education.languagesTitle}</h3>
          <dl>
            {
              t.education.languages.map((l) => (
                <div class="lang-row">
                  <dt>{l.name}</dt>
                  <dd>{l.level}</dd>
                </div>
              ))
            }
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contacto" class="contact" aria-labelledby="contacto-title">
    <div class="wrap contact-grid">
      <div>
        <p class="label label-night">{t.contact.label}</p>
        <h2 id="contacto-title">{t.contact.title}</h2>
        <p class="contact-body">{t.contact.body}</p>
      </div>
      <ul class="contact-list">
        <li>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M3 6l9 7 9-7" /></svg>
          <a href={`mailto:${contact.email}`}>
            <span class="sr-only">{t.contact.emailLabel}: </span>{contact.email}
          </a>
        </li>
        <li>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 7-5 5 5 5" /><path d="m16 7 5 5-5 5" /></svg>
          <a href={contact.github} rel="noopener" target="_blank">
            <span class="sr-only">{t.contact.githubLabel}: </span>github.com/{contact.githubHandle}
          </a>
        </li>
        <li>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></svg>
          <span>
            {t.contact.location}
            <span class="muted-line">{t.contact.availability}</span>
          </span>
        </li>
      </ul>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="wrap footer-row">
    <div class="lockup lockup-static">
      <Monogram id="footer" width={36} accent="var(--accent-night)" ink="var(--paper)" label="" />
      <span class="wordmark wordmark-sm"><span>F</span>Cabrera</span>
    </div>
    <p>© {year} {t.footer.rights}</p>
    <a class="lang-pill" href={otherHref} hreflang={otherLang} lang={otherLang}>{t.nav.switchLabel}</a>
  </div>
</footer>

<style>
  /* ---------- Header ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--night) 92%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--night-line);
  }
  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 72px;
  }
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--paper);
  }
  .lockup:hover {
    color: var(--paper);
  }
  .wordmark {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--paper);
  }
  .wordmark span {
    color: var(--accent-night);
  }
  .wordmark-sm {
    font-size: 18px;
  }
  .nav-links {
    list-style: none;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    color: var(--paper-muted);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .nav-links a:hover {
    color: var(--paper);
  }
  .lang-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    padding: 0 14px;
    border: 1px solid var(--night-line);
    border-radius: 999px;
    color: var(--paper) !important;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .lang-pill:hover {
    border-color: var(--accent-night);
  }
  @media (max-width: 820px) {
    .hide-sm {
      display: none;
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    background: var(--night);
    color: var(--paper);
    padding: clamp(56px, 9vw, 120px) 0 clamp(64px, 10vw, 128px);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(44px, 7.4vw, 92px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.98;
    color: var(--paper);
  }
  .role {
    margin-top: 18px;
    font-size: clamp(14px, 1.6vw, 18px);
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent-night);
  }
  .lead {
    margin-top: 28px;
    max-width: 34em;
    font-size: clamp(17px, 1.7vw, 20px);
    line-height: 1.65;
    color: var(--paper-muted);
  }
  .status {
    margin-top: 22px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 34em;
    font-size: 15px;
    font-weight: 500;
    color: var(--paper);
  }
  .dot {
    flex: none;
    width: 10px;
    height: 10px;
    margin-top: 8px;
    border-radius: 50%;
    background: var(--accent-night);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent-night) 22%, transparent);
  }
  .ctas {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 26px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .btn-primary {
    background: #0f7f55;
    color: #ffffff;
  }
  .btn-primary:hover {
    background: #0b6b47;
    color: #ffffff;
  }
  .btn-ghost {
    border: 1.5px solid var(--night-line);
    color: var(--paper);
  }
  .btn-ghost:hover {
    border-color: var(--paper-muted);
    color: var(--paper);
  }
  .hero-mark {
    display: flex;
    justify-content: center;
  }
  .tile {
    position: relative;
    width: min(100%, 400px);
    aspect-ratio: 1;
    border-radius: 23%;
    background: var(--night-raised);
    border: 1px solid var(--night-line);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tile :global(svg) {
    width: 66%;
    height: auto;
  }
  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-mark {
      order: -1;
      justify-content: flex-start;
    }
    .tile {
      width: 112px;
      border-radius: 26px;
    }
  }

  /* ---------- Sections ---------- */
  .section {
    padding: clamp(72px, 10vw, 128px) 0;
  }
  .section-alt {
    background: var(--surface);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .label {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .label::before {
    content: '';
    width: 22px;
    height: 3px;
    border-radius: 2px;
    background: currentColor;
  }
  .label-gap {
    margin-top: clamp(56px, 8vw, 96px);
  }
  .label-night {
    color: var(--accent-night);
  }
  h2 {
    max-width: 18em;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--ink-strong);
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 80px);
  }
  .prose p + p {
    margin-top: 18px;
  }
  .mini-title {
    margin: 32px 0 14px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .checks {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .checks li {
    position: relative;
    padding-left: 28px;
  }
  .checks li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.55em;
    width: 12px;
    height: 7px;
    border-left: 2.5px solid var(--accent);
    border-bottom: 2.5px solid var(--accent);
    transform: rotate(-45deg);
  }
  @media (max-width: 820px) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  /* Cards */
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .section-alt .card {
    background: var(--ground);
  }
  .num {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .focus-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .focus-card {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .focus-card h3 {
    margin-top: 18px;
    font-size: 20px;
    font-weight: 700;
    color: var(--ink-strong);
  }
  .focus-card p {
    font-size: 15px;
    color: var(--muted);
  }

  /* Projects */
  .projects {
    margin-top: 48px;
    display: grid;
    gap: 20px;
  }
  .project {
    padding: clamp(24px, 4vw, 44px);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: clamp(20px, 4vw, 56px);
  }
  .project-head h3 {
    margin-top: 14px;
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--ink-strong);
  }
  .project-role {
    margin-top: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }
  .project-summary {
    margin-bottom: 18px;
    font-size: 18px;
    font-weight: 500;
    color: var(--ink-strong);
  }
  .project-body .checks {
    font-size: 15px;
  }
  .text-link {
    margin-top: 22px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 600;
    text-decoration: none;
  }
  .text-link:hover {
    text-decoration: underline;
  }
  @media (max-width: 820px) {
    .project {
      grid-template-columns: 1fr;
    }
  }

  /* Chips */
  .chips {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .project-body .chips {
    margin-top: 22px;
  }
  .chips li {
    padding: 6px 13px;
    border-radius: 999px;
    background: var(--chip);
    color: var(--ink-strong);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
  }

  /* Skills */
  .skills-grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px 48px;
  }
  .skill-group {
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .skill-group h3 {
    margin-bottom: 16px;
    font-size: 17px;
    font-weight: 700;
    color: var(--ink-strong);
  }

  /* Education */
  .edu-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin-top: 36px;
    display: grid;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: 24px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .timeline li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .period {
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .timeline h3 {
    font-size: 19px;
    font-weight: 700;
    color: var(--ink-strong);
  }
  .timeline p {
    margin-top: 4px;
    font-size: 15px;
    color: var(--muted);
  }
  .langs {
    padding: 28px;
  }
  .langs .mini-title {
    margin-top: 0;
  }
  .langs dl {
    margin: 0;
  }
  .lang-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }
  .lang-row dt {
    font-weight: 600;
    color: var(--ink-strong);
  }
  .lang-row dd {
    margin: 0;
    font-weight: 500;
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .edu-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  /* ---------- Contact ---------- */
  .contact {
    background: var(--night);
    color: var(--paper);
    padding: clamp(72px, 10vw, 128px) 0;
  }
  .contact h2 {
    color: var(--paper);
    font-size: clamp(36px, 5vw, 60px);
  }
  .contact-body {
    margin-top: 20px;
    max-width: 30em;
    color: var(--paper-muted);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: end;
  }
  .contact-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--night-line);
    font-size: clamp(16px, 1.8vw, 20px);
    font-weight: 500;
  }
  .contact-list svg {
    flex: none;
    margin-top: 2px;
    color: var(--accent-night);
  }
  .contact-list a {
    color: var(--paper);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .contact-list a:hover {
    color: var(--accent-night-strong);
    text-decoration: underline;
  }
  .muted-line {
    display: block;
    margin-top: 2px;
    font-size: 15px;
    color: var(--paper-muted);
  }
  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Footer ---------- */
  .site-footer {
