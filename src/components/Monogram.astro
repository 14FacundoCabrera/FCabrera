---
// FC monogram from the FCabrera brand canvas (Logo FCabrera).
// The F is cut by a circle; the C is an open arc sitting in that cut.
interface Props {
  id: string;
  width?: number;
  accent?: string;
  ink?: string;
  label?: string;
  class?: string;
}
const {
  id,
  width = 120,
  accent = 'var(--accent)',
  ink = 'var(--ink)',
  label = 'FC',
  class: className,
} = Astro.props;
const height = Math.round((width * 140) / 200);
const maskId = `fc-cut-${id}`;
---
<svg
  viewBox="0 0 200 140"
  width={width}
  height={height}
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <defs>
    <mask id={maskId}>
      <rect x="0" y="0" width="200" height="140" fill="#fff"></rect>
      <circle cx="135" cy="70" r="66" fill="#000"></circle>
    </mask>
  </defs>
  <g mask={`url(#${maskId})`} style={`fill:${accent}`}>
    <rect x="10" y="10" width="31" height="120"></rect>
    <rect x="10" y="10" width="130" height="28"></rect>
    <rect x="10" y="64" width="100" height="27"></rect>
  </g>
  <path
    d="M170.2 40.4 A46 46 0 1 0 170.2 99.6"
    fill="none"
    style={`stroke:${ink}`}
    stroke-width="28"
  ></path>
</svg>
